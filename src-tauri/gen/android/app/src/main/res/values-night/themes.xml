<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.termimus" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- The app UI is always dark. Paint the window and the system splash
             screen in the same canvas colour so launch does not flash white
             before the WebView draws its first frame. -->
        <item name="android:windowBackground">@color/app_canvas</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/app_canvas</item>
    </style>
</resources>
