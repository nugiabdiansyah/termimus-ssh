<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). The foreground bitmap is the full
     Termimus tile, so it is inset to keep the prompt glyph and status dot
     inside the launcher's circular/squircle mask instead of being clipped. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
    <inset android:drawable="@mipmap/ic_launcher_foreground" android:inset="18%"/>
  </foreground>
</adaptive-icon>
